rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model: users/{uid} stores name, email, is_admin, and created_at.
    // Private subcollections are scoped to that UID:
    // profile/current stores bounded profile fields and a base64 profile image;
    // medicines stores prescription maps; measurements stores bounded numeric
    // health readings and a server timestamp; reminders stores title, time,
    // active state, completion date, and creation time; prescription_completions
    // stores prescription ID, intake time, completion date, and creation time;
    // patients stores bounded patient details and lists; patients/{id}/visits
    // stores bounded visit details. The profile, patient, and visit documents
    // contain private health data and are readable only by their owner.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownerExists(userId) {
      return isOwner(userId) &&
        (exists(/databases/$(database)/documents/users/$(userId)) ||
          getAfter(/databases/$(database)/documents/users/$(userId)).data.email
            == request.auth.token.email);
    }

    function uidUnchanged(data, userId) {
      return !('uid' in data) || data.uid == userId;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function validString(data, field, maxLength) {
      return data[field] is string && data[field].size() <= maxLength;
    }

    function validOptionalNumber(data, field, minimum, maximum) {
      return !(field in data) || data[field] == null ||
        (data[field] is number &&
          data[field] >= minimum && data[field] <= maximum);
    }

    function validList(data, field, maxItems) {
      return data[field] is list && data[field].size() <= maxItems;
    }

    function validEmail(value) {
      return value is string &&
        value.size() <= 254 &&
        value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function validDate(value) {
      return value is string &&
        (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['name', 'email', 'is_admin', 'created_at']) &&
        data.keys().hasOnly(['name', 'email', 'is_admin', 'created_at']) &&
        validString(data, 'name', 80) &&
        validEmail(data.email) &&
        data.email == request.auth.token.email &&
        data.is_admin == false &&
        data.created_at is timestamp &&
        uidUnchanged(data, userId);
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'age', 'gender', 'blood_type', 'height_cm', 'weight_kg', 'bmi',
          'location', 'conditions', 'medications', 'appetite', 'daily_routine',
          'family_history', 'profile_image', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'age', 'gender', 'blood_type', 'height_cm', 'weight_kg', 'bmi',
          'location', 'conditions', 'medications', 'appetite', 'daily_routine',
          'family_history', 'profile_image', 'updated_at'
        ]) &&
        validOptionalNumber(data, 'age', 1, 120) &&
        validString(data, 'gender', 40) &&
        validString(data, 'blood_type', 10) &&
        validOptionalNumber(data, 'height_cm', 40, 260) &&
        validOptionalNumber(data, 'weight_kg', 2, 400) &&
        validOptionalNumber(data, 'bmi', 0, 100) &&
        validString(data, 'location', 120) &&
        validList(data, 'conditions', 30) &&
        validList(data, 'medications', 50) &&
        validString(data, 'appetite', 500) &&
        validString(data, 'daily_routine', 2000) &&
        validString(data, 'family_history', 2000) &&
        data.profile_image is string &&
        data.profile_image.size() <= 900000 &&
        data.updated_at is timestamp &&
        data.updated_at == request.time;
    }

    function isValidMedicine(data, medicineId) {
      return data.keys().hasAll([
          'id', 'name', 'prescribed_dose', 'quantity', 'intake_times',
          'instructions'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'prescribed_dose', 'quantity', 'intake_times',
          'instructions'
        ]) &&
        data.id == medicineId &&
        validString(data, 'name', 100) &&
        data.name.size() > 0 &&
        validString(data, 'prescribed_dose', 100) &&
        validString(data, 'quantity', 60) &&
        data.intake_times is list &&
        data.intake_times.size() <= 8 &&
        validString(data, 'instructions', 240);
    }

    function isValidMeasurement(data) {
      return data.keys().hasAll(['id', 'recorded_at']) &&
        data.keys().hasOnly([
          'id', 'steps', 'active_minutes', 'sleep_hours', 'fasting_glucose',
          'systolic_bp', 'diastolic_bp', 'recorded_at'
        ]) &&
        validString(data, 'id', 128) &&
        validOptionalNumber(data, 'steps', 0, 200000) &&
        validOptionalNumber(data, 'active_minutes', 0, 1440) &&
        validOptionalNumber(data, 'sleep_hours', 0, 24) &&
        validOptionalNumber(data, 'fasting_glucose', 20, 1000) &&
        validOptionalNumber(data, 'systolic_bp', 50, 300) &&
        validOptionalNumber(data, 'diastolic_bp', 30, 200) &&
        data.keys().hasAny([
          'steps', 'active_minutes', 'sleep_hours', 'fasting_glucose',
          'systolic_bp', 'diastolic_bp'
        ]) &&
        data.recorded_at is timestamp &&
        data.recorded_at == request.time;
    }

    function isValidReminder(data) {
      return data.keys().hasAll([
          'id', 'title', 'scheduled_time', 'instruction', 'active',
          'created_at', 'completed_on'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'scheduled_time', 'instruction', 'active',
          'created_at', 'completed_on'
        ]) &&
        validString(data, 'id', 128) &&
        validString(data, 'title', 100) &&
        data.title.size() > 0 &&
        validString(data, 'scheduled_time', 5) &&
        data.scheduled_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        validString(data, 'instruction', 120) &&
        data.active is bool &&
        data.created_at is timestamp &&
        validDate(data.completed_on);
    }

    function isValidPatient(data) {
      return data.keys().hasAll([
          'patient_id', 'name', 'age', 'gender', 'phone', 'email',
          'blood_group', 'address', 'emergency_contact', 'chronic_conditions',
          'allergies', 'current_medications', 'notes', 'created_at',
          'updated_at'
        ]) &&
        data.keys().hasOnly([
          'patient_id', 'name', 'age', 'gender', 'phone', 'email',
          'blood_group', 'address', 'emergency_contact', 'chronic_conditions',
          'allergies', 'current_medications', 'notes', 'created_at',
          'updated_at'
        ]) &&
        validString(data, 'patient_id', 50) &&
        data.patient_id.size() > 0 &&
        validString(data, 'name', 120) &&
        data.name.size() > 0 &&
        data.age is int && data.age >= 0 && data.age <= 150 &&
        validString(data, 'gender', 40) &&
        validString(data, 'phone', 30) &&
        validString(data, 'email', 254) &&
        (data.email == '' || validEmail(data.email)) &&
        validString(data, 'blood_group', 10) &&
        validString(data, 'address', 255) &&
        validString(data, 'emergency_contact', 100) &&
        validList(data, 'chronic_conditions', 50) &&
        validList(data, 'allergies', 50) &&
        validList(data, 'current_medications', 50) &&
        validString(data, 'notes', 1500) &&
        data.created_at is timestamp &&
        data.updated_at is timestamp &&
        data.updated_at == request.time;
    }

    function isValidVisit(data) {
      return data.keys().hasAll([
          'id', 'visit_date', 'chief_complaint', 'diagnosis', 'systolic_bp',
          'diastolic_bp', 'fasting_glucose', 'heart_rate', 'temperature',
          'weight_kg', 'prescriptions', 'clinical_notes', 'next_followup',
          'created_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'visit_date', 'chief_complaint', 'diagnosis', 'systolic_bp',
          'diastolic_bp', 'fasting_glucose', 'heart_rate', 'temperature',
          'weight_kg', 'prescriptions', 'clinical_notes', 'next_followup',
          'created_at'
        ]) &&
        validString(data, 'id', 128) &&
        validDate(data.visit_date) &&
        validString(data, 'chief_complaint', 255) &&
        validString(data, 'diagnosis', 255) &&
        validOptionalNumber(data, 'systolic_bp', 30, 350) &&
        validOptionalNumber(data, 'diastolic_bp', 20, 250) &&
        validOptionalNumber(data, 'fasting_glucose', 10, 1200) &&
        validOptionalNumber(data, 'heart_rate', 20, 300) &&
        validOptionalNumber(data, 'temperature', 25, 50) &&
        validOptionalNumber(data, 'weight_kg', 2, 400) &&
        data.prescriptions is list &&
        data.prescriptions.size() <= 50 &&
        validString(data, 'clinical_notes', 2000) &&
        validDate(data.next_followup) &&
        data.created_at is timestamp;
    }

    function isValidPrescriptionCompletion(data) {
      return data.keys().hasAll([
          'prescription_id', 'scheduled_time', 'completed_on', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'prescription_id', 'scheduled_time', 'completed_on', 'created_at'
        ]) &&
        validString(data, 'prescription_id', 32) &&
        validString(data, 'scheduled_time', 5) &&
        data.scheduled_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.completed_on is string &&
        data.completed_on.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.created_at is timestamp &&
        data.created_at == request.time;
    }

    // User documents contain private account details and are owner-only.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data, userId) &&
        request.resource.data.created_at == request.time;
      allow update: if isOwner(userId) &&
        isValidUser(request.resource.data, userId) &&
        uidNotModified() &&
        request.resource.data.is_admin == resource.data.is_admin &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;

      match /profile/{profileId} {
        allow read: if ownerExists(userId) && profileId == 'current';
        allow create, update: if ownerExists(userId) &&
          profileId == 'current' &&
          isValidProfile(request.resource.data);
        allow delete: if false;
      }

      match /medicines/{medicineId} {
        allow read: if ownerExists(userId);
        allow create: if ownerExists(userId) &&
          isValidMedicine(request.resource.data, medicineId);
        allow update: if ownerExists(userId) &&
          isValidMedicine(request.resource.data, medicineId) &&
          request.resource.data.id == resource.data.id;
        allow delete: if ownerExists(userId);
      }

      match /measurements/{measurementId} {
        allow read: if ownerExists(userId);
        allow create: if ownerExists(userId) &&
          isValidMeasurement(request.resource.data) &&
          request.resource.data.id == measurementId;
        allow update, delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if ownerExists(userId);
        allow create: if ownerExists(userId) &&
          isValidReminder(request.resource.data) &&
          request.resource.data.id == reminderId &&
          request.resource.data.created_at == request.time;
        allow update: if ownerExists(userId) &&
          isValidReminder(request.resource.data) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.created_at == resource.data.created_at &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed_on']);
        allow delete: if ownerExists(userId);
      }

      match /prescription_completions/{completionId} {
        allow read: if ownerExists(userId);
        allow create, update: if ownerExists(userId) &&
          isValidPrescriptionCompletion(request.resource.data);
        allow delete: if false;
      }

      match /patients/{patientDocumentId} {
        allow read: if ownerExists(userId);
        allow create: if ownerExists(userId) &&
          isValidPatient(request.resource.data) &&
          request.resource.data.created_at == request.time &&
          request.resource.data.updated_at == request.time;
        allow update: if ownerExists(userId) &&
          isValidPatient(request.resource.data) &&
          request.resource.data.created_at == resource.data.created_at &&
          request.resource.data.updated_at == request.time;
        allow delete: if ownerExists(userId);

        match /visits/{visitId} {
          allow read: if ownerExists(userId);
          allow create: if ownerExists(userId) &&
            isValidVisit(request.resource.data) &&
            request.resource.data.id == visitId &&
            request.resource.data.created_at == request.time;
          allow update: if ownerExists(userId) &&
            isValidVisit(request.resource.data) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.created_at == resource.data.created_at;
          allow delete: if ownerExists(userId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
