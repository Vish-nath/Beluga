MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
# Optional override; otherwise the URI database name is used, defaulting to beluga.
# MONGODB_DATABASE=beluga

# Comma-separated list of allowed CORS origins (defaults to localhost only).
# Add your production domain or tunnel URL here, e.g.:
# ALLOWED_ORIGINS=http://localhost:8000,https://your-tunnel.trycloudflare.com
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: Enable Google Sign-In by providing your OAuth 2.0 Client ID.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com